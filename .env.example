# Tsilo - Private Terraform Module Registry
# Copy to .env and update with your values

# Application Environment
APP_ENV=development
APP_BASE_URL=http://localhost:8000

# Database Configuration
# Use postgresql+asyncpg:// for the async driver (required at runtime).
# Alembic migrations automatically convert to the sync driver.
DATABASE_URL=postgresql+asyncpg://tsilo:tsilo@localhost:5432/tsilo

# S3 Storage Configuration (using MinIO for local development)
S3_BUCKET=tsilo-modules
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1

# OIDC Authentication Configuration
OIDC_ISSUER=https://your-oidc-provider.com
OIDC_CLIENT_ID=tsilo-dev
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# Security
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
CSRF_SECRET_KEY=dev-csrf-secret-change-in-production-use-openssl-rand-hex-32
ADMIN_GROUP=tsilo-admins

# Logging
LOG_LEVEL=INFO

# Health checks and metrics
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
